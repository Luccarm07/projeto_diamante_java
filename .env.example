# Copy this file to order-service/.env (or export the variables in your shell).
# The .env file is ignored by git, so the key never reaches the repository.
# Format: KEY=value, one per line, no quotes and no comments after the value.

# Option A: OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Option B: local model with an OpenAI-compatible API (uncomment ONE base url)
# LM Studio:
# OPENAI_BASE_URL=http://localhost:1234/v1
# Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=qwen2.5-7b-instruct
